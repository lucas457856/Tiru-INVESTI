rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Helpers -----

    // Lê o perfil do usuário autenticado em /usuarios/{request.auth.uid}.
    // Custa 1 leitura por avaliação (regras de listagem podem chamar isso
    // por documento). Para o volume atual do projeto, é aceitável.
    //
    // NOTA: se a regra de /usuarios/{uid} não permitir que o próprio
    // usuário leia o próprio perfil, ESTE helper sempre falhará, e todas
    // as regras que dependem dele (clientes, contratos) também. A regra
    // abaixo garante `allow read: if request.auth.uid == uid`.
    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // O usuário autenticado é o próprio dono do documento cujo uid é `uid`?
    function ehDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // O usuário autenticado é um funcionário vinculado ao owner `ownerUid`?
    // Lê o perfil via meuPerfil() e valida role/ownerUid — não há como o
    // cliente mentir no payload.
    function ehFuncionarioDe(ownerUid) {
      return request.auth != null
        && request.auth.uid != ownerUid
        && meuPerfil().ownerUid == ownerUid
        && meuPerfil().role == 'funcionario';
    }

    // O usuário autenticado é o DONO da conta (uid) OU um funcionário
    // vinculado a esse uid? Usado para autorizar tudo dentro do escopo
    // do dono: contratos, clientes, pagamentos, juros, funcionários,
    // notificações. NÃO é usado para config/modelosContrato (esses
    // são exclusivos do dono).
    function ehDonoOuFuncionario(uid) {
      return ehDono(uid) || ehFuncionarioDe(uid);
    }

    // ----- /usuarios/{uid} (perfil raiz) -----

    match /usuarios/{uid} {
      // Qualquer usuário autenticado pode ler o PRÓPRIO perfil. Esta é
      // a permissão base para o helper `meuPerfil()` funcionar.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Criação: o próprio UID cria o próprio perfil. Perfis de DONO
      // não carregam role/ownerUid. Perfis de FUNCIONÁRIO são criados
      // pelo endpoint server-side (Admin SDK, que bypassa as rules).
      // Manter `!('role' in ...)` aqui impede que um usuário finja ser
      // dono via client SDK.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !('role' in request.resource.data)
        && !('ownerUid' in request.resource.data);

      // Update: o próprio UID. Garante imutabilidade de role, ownerUid
      // e funcionarioId. Outros campos podem ser alterados livremente.
      //
      // CAMPOS ADMINISTRATIVOS (status, limites, permissoes, plan):
      //   Esses campos são EXCLUSIVOS do Painel Administrativo principal
      //   (ADMIN_UID) e SÓ podem ser alterados via endpoint server-side
      //   (que usa o Admin SDK e bypassa as rules). O client SDK —
      //   inclusive o próprio dono autenticado — NÃO pode alterá-los.
      //   A regra abaixo exige que o valor enviado no update seja
      //   IDÊNTICO ao valor já persistido. Se o cliente tentar enviar
      //   `limites: { contratos: 5 }` num doc que não tem `limites`,
      //   a comparação falha → PERMISSION_DENIED. (Map equality no
      //   Firestore Rules é por valor, não por identidade de objeto.)
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.funcionarioId == resource.data.funcionarioId
        && request.resource.data.status == resource.data.status
        && request.resource.data.limites == resource.data.limites
        && request.resource.data.permissoes == resource.data.permissoes
        && request.resource.data.plan == resource.data.plan;

      // ====== Subcoleções do dono ======
      // Para TUDO dentro do escopo do dono (exceto config/modelosContrato,
      // que são exclusivos do dono), tanto o DONO quanto seus FUNCIONÁRIOS
      // têm acesso de leitura e escrita — EXCETO na criação dos
      // recursos CRÍTICOS (clientes via top-level, contratos e
      // funcionários), que SÓ podem ser criados via endpoint server-side
      // (/api/admin/criar-cliente, /api/admin/criar-contrato,
      // /api/auth/create-employee). Esses endpoints validam token,
      // limites, permissões e status no Admin SDK antes de gravar.
      //
      // POR QUE A CRIAÇÃO É SERVER-SIDE:
      //   O Firestore Rules não consegue contar documentos de uma
      //   coleção/query de forma confiável e portável para validar
      //   limites. A solução segura é mover o create para endpoints
      //   com Admin SDK, que ignoram as Rules e executam a checagem
      //   no servidor. Mantém `read`, `update` e `delete` no client
      //   SDK para preservar a UX atual (listagem em tempo real,
      //   edição e exclusão). Writes diretos do client em clientes
      //   (top-level), contratos e funcionários são BLOQUEADOS aqui.

      // Funcionários (lista de funcionários do dono)
      // - CREATE: BLOQUEADO via client SDK. Apenas o endpoint
      //   server-side /api/auth/create-employee (Admin SDK) cria.
      // - READ/UPDATE/DELETE: dono total (preserva UX).
      // - O próprio funcionário (authUid == resource.data.authUid): LÊ
      //   seu próprio doc para detectar mudança de status em tempo real.
      match /funcionarios/{funcionarioId} {
        allow read, update, delete: if ehDono(uid);
        allow read: if request.auth != null
          && request.auth.uid == resource.data.authUid;
        // create NÃO é permitido para ninguém via client SDK.
        // Admin SDK (usado pelo endpoint) ignora as Rules.
      }

      // Configurações do dono: SOMENTE o dono
      // (modelosCobranca, preferências, etc.)
      match /config/{docId} {
        allow read, write: if ehDono(uid);
      }

      // Modelos de contrato do dono: SOMENTE o dono
      match /modelosContrato/{modeloId} {
        allow read, write: if ehDono(uid);
      }

      // Modelos de cobrança: SOMENTE o dono
      // (alias de config/modelosCobranca, mas listada por clareza)
      match /modelosCobranca/{docId} {
        allow read, write: if ehDono(uid);
      }

      // Notificações: dono e funcionário do dono acessam
      match /notificacoes/{notifId} {
        allow read, write: if ehDonoOuFuncionario(uid);
      }

      // Clientes (subcoleção legada, usada por BackupDados)
      // - Dono: CRUD total
      // - Funcionário: não tem acesso (a fonte canônica é a coleção
      //   top-level `clientes` com `ownerId`)
      match /clientes/{clienteId} {
        allow read, write: if ehDono(uid);
      }

      // Contratos: dono e funcionário do dono acessam
      // - CREATE: BLOQUEADO via client SDK. Apenas o endpoint
      //   server-side /api/admin/criar-contrato (Admin SDK) cria.
      // - READ/UPDATE/DELETE: dono e funcionário (UX atual preservada).
      match /contratos/{contratoId} {
        allow read, update, delete: if ehDonoOuFuncionario(uid);
        // create NÃO é permitido para ninguém via client SDK.

        // Subcoleção de pagamentos (4º nível)
        match /pagamentos/{pagamentoId} {
          allow read, write: if ehDonoOuFuncionario(uid);
        }

        // Subcoleção de recebimentos de juros (4º nível)
        match /jurosRecebidos/{jurosId} {
          allow read, write: if ehDonoOuFuncionario(uid);
        }
      }
    }

    // ----- /clientes/{clienteId} (coleção top-level — fonte canônica) -----

    match /clientes/{clienteId} {
      // Dono: lê/atualiza/exclui clientes com ownerId == seu uid
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Funcionário: lê/atualiza/exclui clientes com ownerId == ownerUid
      // do seu perfil (vínculo funcionário → dono).
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == meuPerfil().ownerUid
        && meuPerfil().role == 'funcionario';

      // CREATE: BLOQUEADO via client SDK. Apenas o endpoint server-side
      // /api/admin/criar-cliente (Admin SDK) cria. Esse endpoint
      // valida token, limites, permissões e status no servidor.
      // O dono NÃO pode mais criar clientes chamando addDoc direto
      // (mesmo burlando o JS) — a checagem real acontece no Admin SDK.
      //
      // Mantemos a regra original comentada abaixo como referência:
      //   allow create: if request.auth != null
      //     && (
      //       request.resource.data.ownerId == request.auth.uid
      //       || (
      //         request.resource.data.ownerId == meuPerfil().ownerUid
      //         && meuPerfil().role == 'funcionario'
      //       )
      //     )
      //     && (
      //       !('createdBy' in request.resource.data)
      //       || request.resource.data.createdBy == request.auth.uid
      //     );
    }
  }
}
